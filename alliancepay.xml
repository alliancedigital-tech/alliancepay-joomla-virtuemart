<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="vmpayment" version="5.0" method="upgrade">
    <name>VM - AlliancePay</name>
    <author>Alliance Dgtl.</author>
    <creationDate>2026-09-25</creationDate>
    <license>GNU General Public License v2 or later</license>
    <version>1.5.0</version>
    <description>Alliance Payment Gateway for VirtueMart</description>
    <namespace path="src">Alliance\Plugin\Vmpayment\Alliancepay</namespace>
    <element>alliancepay</element>
    <files>
        <filename plugin="alliancepay">src/Extension/AlliancePay.php</filename>
        <file>index.html</file>
        <folder>services</folder>
        <folder>src</folder>
        <folder>sql</folder>
        <folder>tmpl</folder>
        <folder>vendor</folder>
        <folder>language</folder>
    </files>
    <install>
        <sql>
            <file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
        </sql>
    </install>
    <update>
        <schemas>
            <schemapath type="mysql">sql/updates/mysql</schemapath>
        </schemas>
    </update>
    <services>
        <service name="plg_vmpayment_alliance" file="services/provider.php" />
    </services>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_vmpayment_alliancepay.ini</language>
        <language tag="uk-UA">language/uk-UA/uk-UA.plg_vmpayment_alliancepay.ini</language>
    </languages>
    <vmconfig>
        <fields name="params">
            <fieldset name="basic" label="VMPAYMENT_ALLIANCEPAY_BASIC">
                <field
                    name="status_page_type"
                    type="list"
                    default="STATUS_TIMER_PAGE"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_PAGE_TYPE"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_PAGE_TYPE_DESC">
                    <option value="STATUS_TIMER_PAGE">VMPAYMENT_ALLIANCEPAY_STATUS_TIMER_PAGE</option>
                    <option value="STATUS_REDIRECT_MERCHANT_PAGE">VMPAYMENT_ALLIANCEPAY_STATUS_REDIRECT</option>
                    <option value="STATUS_PAGE">VMPAYMENT_ALLIANCEPAY_STATUS_PAGE</option>
                </field>
                <field
                        name="payment_type"
                        type="list"
                        default="PURCHASE"
                        label="VMPAYMENT_ALLIANCEPAY_HPP_PAYMENT_TYPE"
                        description="VMPAYMENT_ALLIANCEPAY_HPP_PAYMENT_TYPE_DESC"
                        id="alliancepay_payment_type">
                    <option value="PURCHASE">PURCHASE</option>
                    <option value="A2A">A2A</option>
                    <option value="PREAUTH">PREAUTH</option>
                </field>

                <field
                    name="preauth_exp_date"
                    type="list"
                    default="2h"
                    label="VMPAYMENT_ALLIANCEPAY_PREAUTH_EXP_DATE"
                    description="VMPAYMENT_ALLIANCEPAY_PREAUTH_EXP_DATE_DESC">
                    <option value="2h">2h</option>
                    <option value="4h">4h</option>
                    <option value="6h">6h</option>
                    <option value="12h">12h</option>
                    <option value="1d">1d</option>
                    <option value="2d">2d</option>
                    <option value="7d">7d</option>
                    <option value="14d">14d</option>
                    <option value="28d">28d</option>
                </field>
                <field
                    name="api_url"
                    type="url"
                    label="VMPAYMENT_ALLIANCEPAY_API_URL"
                    description="VMPAYMENT_ALLIANCEPAY_API_URL_DESC"
                    schemes="https"
                    validate="url"
                    required="true"
                />
                <field
                    name="merchant_id"
                    type="text"
                    label="VMPAYMENT_ALLIANCEPAY_MERCHANT_ID"
                    description="VMPAYMENT_ALLIANCEPAY_MERCHANT_ID_DESC"
                    required="true"
                />
                <field
                    name="auth_key"
                    type="textarea"
                    label="VMPAYMENT_ALLIANCEPAY_AUTH_KEY"
                    description="VMPAYMENT_ALLIANCEPAY_AUTH_KEY_DESC"
                    rows="5"
                    cols="50"
                    required="true"
                />
                <field
                    name="jws_private_key"
                    type="textarea"
                    label="VMPAYMENT_ALLIANCEPAY_JWS_PRIVATE_KEY"
                    description="VMPAYMENT_ALLIANCEPAY_JWS_PRIVATE_KEY_DESC"
                    rows="8"
                    cols="50"
                    required="true"
                />
                <field
                    name="jws_key_id"
                    type="text"
                    label="VMPAYMENT_ALLIANCEPAY_JWS_KEY_ID"
                    description="VMPAYMENT_ALLIANCEPAY_JWS_KEY_ID_DESC"
                    required="true"
                />
            </fieldset>
            <fieldset name="statuses" label="VMPAYMENT_ALLIANCEPAY_STATUSES">

                <field
                    name="status_payment_success"
                    type="vmorderstate"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_PAYMENT_SUCCESS"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_PAYMENT_SUCCESS_DESC"
                />
                <field
                    name="status_payment_fail"
                    type="vmorderstate"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_PAYMENT_FAIL"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_PAYMENT_FAIL_DESC"
                />
                <field
                    name="status_refund_success"
                    type="vmorderstate"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_REFUND_SUCCESS"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_REFUND_SUCCESS_DESC"
                />
                <field
                    name="status_refund_fail"
                    type="vmorderstate"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_REFUND_FAIL"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_REFUND_FAIL_DESC"
                />
                <field
                    name="status_preauth_pending"
                    type="vmorderstate"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_PREAUTH_PENDING"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_PREAUTH_PENDING_DESC"
                />
                <field
                    name="status_completion_trigger"
                    type="vmorderstate"
                    label="VMPAYMENT_ALLIANCEPAY_STATUS_COMPLETION_TRIGGER"
                    description="VMPAYMENT_ALLIANCEPAY_STATUS_COMPLETION_TRIGGER_DESC"
                />
            </fieldset>
            <fieldset name="subscriptions" label="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTIONS">
                <field
                    name="subscriptions_enabled"
                    type="radio"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                    label="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTIONS_ENABLED"
                    description="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTIONS_ENABLED_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
                <field
                    name="subscription_reprice_min_days"
                    type="number"
                    default="30"
                    min="1"
                    step="1"
                    label="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTION_REPRICE_MIN_DAYS"
                    description="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTION_REPRICE_MIN_DAYS_DESC"
                />
                <field
                    name="subscription_content_type"
                    type="list"
                    default="application/jwt"
                    label="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTION_CONTENT_TYPE"
                    description="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTION_CONTENT_TYPE_DESC">
                    <option value="application/jwt">application/jwt</option>
                    <option value="application/jws">application/jws</option>
                </field>
                <field
                    name="subscription_send_api_version"
                    type="radio"
                    default="0"
                    layout="joomla.form.field.radio.switcher"
                    label="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTION_SEND_API_VERSION"
                    description="VMPAYMENT_ALLIANCEPAY_SUBSCRIPTION_SEND_API_VERSION_DESC">
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
        </fields>
    </vmconfig>
    <vmref>alliancepay</vmref>
</extension>
